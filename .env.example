# Backend (blastradius-api / ui.server) -- how it reaches HydraDB, and who
# it will accept cross-origin browser requests from.
#
# Copy to .env and fill in real values: `cp .env.example .env`
# Never commit .env -- it's gitignored on purpose.

# Where HydraDB is reachable from this process.
#   Local dev (HydraDB via `python -m blastradius.cli up`):
HYDRA_HTTP=http://127.0.0.1:8443
#   Hosted (docker-compose, HydraDB reached by its service name):
#   HYDRA_HTTP=http://hydradb:8443

# Must match the token HydraDB was started with (GRAPH_AUTH_TOKEN_FILE).
#   Local dev: the value `blastradius.cli up` seeds automatically -- see
#   hydradb-data/auth-token after running it.
#   Hosted: generate one with `openssl rand -hex 32` and use the same value
#   for both HYDRA_TOKEN here and GRAPH_AUTH_TOKEN_FILE's contents on hydradb.
HYDRA_TOKEN=local-development-token-32-bytes

HYDRA_NAMESPACE=default
HYDRA_GRAPH=default

# Browser origin(s) allowed to call this API. Comma-separate for more than
# one; "*" allows any origin (fine here since there's no cookie/session auth
# to leak, but tighten this once you have a fixed domain).
#   Local dev (Vite dev server):
CORS_ALLOW_ORIGINS=http://localhost:5173
#   Hosted (Vercel):
#   CORS_ALLOW_ORIGINS=https://your-app.vercel.app
