# Backend API URL the console calls.
#
# Copy to .env for local testing, or set VITE_API_URL directly in the Vercel
# project's Environment Variables for the hosted build.

#   Local dev -- blastradius/api/main.py (npm run dev proxies /api already,
#   so this is only needed for `npm run build` done locally):
VITE_API_URL=http://localhost:8000
#   Local dev -- ui.server / Explorer instead:
#   VITE_API_URL=http://localhost:8100

#   Hosted -- your EC2 instance's public IP or domain:
#   VITE_API_URL=https://your-ec2-domain-or-ip

# Leave unset (delete the line) for a same-origin deploy where FastAPI serves
# this build itself from ui/static/app -- it then defaults to relative paths.
