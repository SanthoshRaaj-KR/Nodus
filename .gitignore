node_modules/
__pycache__/
*.pyc
data/ids.sqlite*
# Chat agent local state. Workspaces name absolute paths to somebody's
# checkouts, sessions are conversation history, and the advisory cache is
# rebuilt from whatever has been scanned -- all three are per-machine.
data/chat-workspaces.json
data/chat-sessions.sqlite*
data/chat-advisory-cache.json
corpus/*/node_modules/
.pytest_cache/
.playwright-mcp/

# Cloned repos under test are somebody else's history, not ours. Only the
# planted demo fixture is tracked; anything else dropped in corpus/ stays out.
corpus/*
!corpus/payment-api/
!corpus/fleet/
registry-cache
# Scan output. Both are derived from whatever repository was last scanned, so
# committing them would put a fixed set of vulnerabilities back in the tree --
# exactly what scanning exists to replace.
data/osv/
advisories/generated/

# Built console bundle. Generated by `npm run build` in ui/web; committing it
# would put a stale copy of the UI in the tree that silently wins over source.
ui/static/app/

# Local/deployment secrets and endpoints. Never commit real tokens or hosts --
# only the .env.example templates are tracked.
.env
.env.*
!.env.example
!**/.env.example
