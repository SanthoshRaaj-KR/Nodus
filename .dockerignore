.venv
**/node_modules
.git
.pytest_cache
.playwright-mcp
__pycache__
**/__pycache__
*.pyc

# Local runtime state: the id allocator, chat workspace registry, caches.
# Baking a build machine's copy into the image would ship its id history
# into the container -- desynced against whatever HydraDB already has for
# a hosted deployment, since ids are assigned by insertion order into this
# file, not derived from the graph.
data/
corpus/*
!corpus/fleet/
!corpus/GenReal.ai/
.env
